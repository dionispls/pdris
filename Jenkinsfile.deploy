pipeline {
    agent any
    
    environment {
        NEXUS_URL = "http://localhost:8081"
        NEXUS_CREDENTIALS_ID = "nexus_cred"
        DOCKER_REGISTRY = "localhost:8082"
        PROJECT_NAME = 'foodgram'
        BUILD_NUMBER = "${params.BUILD_NUMBER ?: 'latest'}"
        ANSIBLE_HOST = "${params.ANSIBLE_HOST ?: 'localhost'}"
    }
    
    parameters {
        string(name: 'BUILD_NUMBER', defaultValue: 'latest', description: 'Build number')
        string(name: 'ANSIBLE_HOST', defaultValue: 'localhost', description: 'Host')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm: [
                    $class: 'GitSCM',
                    branches: [[name: 'homework-5']],
                    userRemoteConfigs: [[url: 'https://github.com/dionispls/pdris.git']]
                ]
            }
        }
        
        stage('Download from Nexus') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${NEXUS_CREDENTIALS_ID}", usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                        sh """
                            echo ${NEXUS_PASS} | docker login ${DOCKER_REGISTRY} -u ${NEXUS_USER} --password-stdin
                            docker pull ${DOCKER_REGISTRY}/${PROJECT_NAME}-backend:${BUILD_NUMBER}
                            docker pull ${DOCKER_REGISTRY}/${PROJECT_NAME}-frontend:${BUILD_NUMBER}
                            docker tag ${DOCKER_REGISTRY}/${PROJECT_NAME}-backend:${BUILD_NUMBER} ${PROJECT_NAME}-backend:${BUILD_NUMBER}
                            docker tag ${DOCKER_REGISTRY}/${PROJECT_NAME}-frontend:${BUILD_NUMBER} ${PROJECT_NAME}-frontend:${BUILD_NUMBER}
                        """
                    }
                }
            }
        }
        
        stage('Run Ansible') {
            steps {
                script {
                    def ansibleDir = "${WORKSPACE}/infra/ansible"
                    sh """
                        cd ${ansibleDir} &&
                        tar czf - . | docker run --rm -i \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            -v /var/jenkins_home:/var/jenkins_home \
                            -e HOME=/var/jenkins_home \
                            -e DOCKER_HOST=unix:///var/run/docker.sock \
                            -w /ansible \
                            python:3.11-slim bash -c "
                                pip install ansible docker &&
                                tar xzf - &&
                                echo 'Contents of /ansible:' &&
                                ls -la /ansible &&
                                ansible-playbook -i inventory site.yml \
                                    -e 'docker_backend_image=${PROJECT_NAME}-backend:${BUILD_NUMBER}' \
                                    -e 'docker_frontend_image=${PROJECT_NAME}-frontend:${BUILD_NUMBER}' \
                                    -e 'ansible_env_HOME=/var/jenkins_home' \
                                    --connection=local \
                                    --skip-tags deploy
                            "
                    """
                }
            }
        }
        
        stage('Deploy Application') {
            steps {
                script {
                    sh """
                        echo "Files"
                        DEPLOY_DIR=\$(find /var/jenkins_home -type d -name "foodgram" 2>/dev/null | grep -v workspace | head -1)
                        if [ -z "\$DEPLOY_DIR" ]; then
                            echo "Creating deploy directory..."
                            DEPLOY_DIR="/var/jenkins_home/foodgram"
                            mkdir -p \$DEPLOY_DIR
                        fi
                        echo "Using deploy directory: \$DEPLOY_DIR"
                        ls -la \$DEPLOY_DIR/ || echo "Directory is empty"
                        
                        echo "Creating/updating deploy.sh..."
                        cat > \$DEPLOY_DIR/deploy.sh << 'EOF'
#!/bin/bash
set -e
cd /var/jenkins_home/foodgram

if docker compose version >/dev/null 2>&1; then
    COMPOSE_CMD="docker compose"
elif docker-compose version >/dev/null 2>&1; then
    COMPOSE_CMD="docker-compose"
else
    echo "Installing docker-compose"
    curl -L "https://github.com/docker/compose/releases/download/v2.24.0/docker-compose-\$(uname -s)-\$(uname -m)" -o /usr/local/bin/docker-compose
    chmod +x /usr/local/bin/docker-compose
    COMPOSE_CMD="docker-compose"
fi

docker network create foodgram_network || true
\$COMPOSE_CMD down || true
\$COMPOSE_CMD up -d
EOF
                        chmod +x \$DEPLOY_DIR/deploy.sh

                        cat > \$DEPLOY_DIR/docker-compose.yml << 'COMPOSEEOF'
version: '3.3'
services:
  frontend:
    container_name: foodgram-front
    image: foodgram-frontend:latest
    volumes:
      - static_dir:/app/result_build/
  nginx:
    container_name: foodgram-proxy
    image: nginx:1.25.4-alpine
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - static_dir:/usr/share/nginx/html/static/
      - media_dir:/usr/share/nginx/html/media/
    depends_on:
      - backend
      - frontend
  backend:
    container_name: foodgram-app
    image: foodgram-backend:latest
    restart: always
    volumes:
      - static_dir:/app/static/
      - media_dir:/app/media/
    env_file:
      - .env
  db:
    container_name: foodgram-db
    image: postgres:13.0-alpine
    restart: always
    volumes:
      - postgres_data:/var/lib/postgresql/data/
    env_file:
      - .env
volumes:
  static_dir:
  media_dir:
  postgres_data:
COMPOSEEOF
                        
                        if [ ! -f "\$DEPLOY_DIR/nginx.conf" ]; then
                            cp ${WORKSPACE}/infra/nginx.conf \$DEPLOY_DIR/nginx.conf || echo "nginx.conf not found in workspace"
                        fi
                        
                        if [ ! -f "\$DEPLOY_DIR/.env" ]; then
                            if [ -f ${WORKSPACE}/.env ]; then
                                cp ${WORKSPACE}/.env \$DEPLOY_DIR/.env
                            else
                                cat > \$DEPLOY_DIR/.env << 'ENVEOF'
DB_ENGINE=django.db.backends.postgresql
DB_NAME=foodgram
DB_USER=foodgram_user
DB_PASSWORD=foodgram_password
DB_HOST=db
DB_PORT=5432
SECRET_KEY=django-insecure-secret-key-change-in-production
ENVEOF
                            fi
                        fi
                        
                        echo "Deploying"
                        cd \$DEPLOY_DIR
                        sed -i 's|image: foodgram-backend:.*|image: foodgram-backend:${BUILD_NUMBER}|g' docker-compose.yml || true
                        sed -i 's|image: foodgram-frontend:.*|image: foodgram-frontend:${BUILD_NUMBER}|g' docker-compose.yml || true
                        bash deploy.sh
                    """
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                sh """
                    docker ps | grep ${PROJECT_NAME} || echo "Containers not found"
                """
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo "OK"
        }
        failure {
            echo "Failed"
        }
    }
}

